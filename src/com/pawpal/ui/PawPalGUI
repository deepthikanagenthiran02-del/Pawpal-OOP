package com.pawpal.ui;

import com.pawpal.dao.*;
import com.pawpal.model.*;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.time.LocalDate;
import java.time.LocalTime;
import java.util.List;

/**
 * PawPalGUI handles the entire Graphical User Interface (GUI) for the PawPal system.
 * It uses Java Swing for the frontend and connects to the DAO layer for database operations.
 * 
 * TEAM CONTRIBUTIONS:
 * - Member 1: LoginFrame, ManageUsersPanel, Vet Registration logic.
 * - Member 2: PetPanel, Pet Owner Registration logic.
 * - Member 3: ViewVetsPanel, ManageVetsPanel.
 * - Member 4: BookApptPanel, ViewApptsPanel (Update/Cancel/Delete), Exit Menu.
 */
public class PawPalGUI {

    // Instantiate DAO objects to handle database communication
    private static final UserDAO userDAO = new UserDAO();
    private static final PetDAO petDAO = new PetDAO();
    private static final VetDAO vetDAO = new VetDAO();
    private static final AppointmentDAO apptDAO = new AppointmentDAO();

    public static void main(String[] args) {
        // SwingUtilities.invokeLater ensures thread-safe GUI creation
        SwingUtilities.invokeLater(() -> new LoginFrame().setVisible(true));
    }

    // =========================================================================
    // MEMBER 1: LOGIN SCREEN
    // =========================================================================
    static class LoginFrame extends JFrame {
        public LoginFrame() {
            setTitle("PawPal - System Login");
            setSize(350, 280);
            setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            setLocationRelativeTo(null);
            setLayout(null); // Absolute positioning

            // UI Components: Labels, TextFields, and Buttons
            JLabel title = new JLabel("PawPal Login");
            title.setFont(new Font("Arial", Font.BOLD, 18));
            title.setBounds(110, 20, 150, 30);
            add(title);

            JLabel emailLbl = new JLabel("Email:");
            emailLbl.setBounds(30, 70, 80, 25);
            add(emailLbl);
            JTextField emailField = new JTextField();
            emailField.setBounds(100, 70, 200, 25);
            add(emailField);

            JLabel passLbl = new JLabel("Password:");
            passLbl.setBounds(30, 110, 80, 25);
            add(passLbl);
            JPasswordField passField = new JPasswordField();
            passField.setBounds(100, 110, 200, 25);
            add(passField);

            JButton loginBtn = new JButton("Login");
            loginBtn.setBounds(100, 160, 100, 30);
            add(loginBtn);

            JButton registerBtn = new JButton("Register");
            registerBtn.setBounds(100, 200, 100, 30);
            add(registerBtn);

            // Event Listener for Login Button
            loginBtn.addActionListener(e -> {
                String email = emailField.getText();
                String pass = new String(passField.getPassword());
                
                // Authenticate user via UserDAO (SELECT query)
                User user = userDAO.login(email, pass);

                if (user != null) {
                    JOptionPane.showMessageDialog(this, "Welcome, " + user.getFullName() + "!\nRole: " + user.getRole());
                    this.dispose(); // Close login window
                    new DashboardFrame(user).setVisible(true); // Open main dashboard
                } else {
                    JOptionPane.showMessageDialog(this, "Invalid email or password!", "Error", JOptionPane.ERROR_MESSAGE);
                }
            });

            // Event Listener to open Registration Window
            registerBtn.addActionListener(e -> new RegisterFrame().setVisible(true));
        }
    }

    // =========================================================================
    // MEMBER 1 & 2: REGISTER SCREEN
    // =========================================================================
    static class RegisterFrame extends JFrame {
        public RegisterFrame() {
            setTitle("PawPal - Register New User");
            setSize(350, 380);
            setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
            setLocationRelativeTo(null);
            setLayout(null);

            JLabel title = new JLabel("Create an Account");
            title.setFont(new Font("Arial", Font.BOLD, 16));
            title.setBounds(90, 10, 200, 30);
            add(title);

            // Common Registration Fields
            JLabel nameLbl = new JLabel("Full Name:");
            nameLbl.setBounds(30, 50, 80, 25);
            add(nameLbl);
            JTextField nameField = new JTextField();
            nameField.setBounds(120, 50, 180, 25);
            add(nameField);

            JLabel emailLbl = new JLabel("Email:");
            emailLbl.setBounds(30, 90, 80, 25);
            add(emailLbl);
            JTextField emailField = new JTextField();
            emailField.setBounds(120, 90, 180, 25);
            add(emailField);

            JLabel passLbl = new JLabel("Password:");
            passLbl.setBounds(30, 130, 80, 25);
            add(passLbl);
            JPasswordField passField = new JPasswordField();
            passField.setBounds(120, 130, 180, 25);
            add(passField);

            JLabel cityLbl = new JLabel("City:");
            cityLbl.setBounds(30, 170, 80, 25);
            add(cityLbl);
            JTextField cityField = new JTextField();
            cityField.setBounds(120, 170, 180, 25);
            add(cityField);

            JLabel roleLbl = new JLabel("Register as:");
            roleLbl.setBounds(30, 210, 80, 25);
            add(roleLbl);
            String[] roles = {"Pet Owner", "Veterinarian"};
            JComboBox<String> roleBox = new JComboBox<>(roles);
            roleBox.setBounds(120, 210, 180, 25);
            add(roleBox);

            // Member 1: Vet-Specific Fields (Hidden by default)
            JLabel specLbl = new JLabel("Specialization:");
            specLbl.setBounds(30, 250, 90, 25);
            specLbl.setVisible(false);
            add(specLbl);
            JTextField specField = new JTextField();
            specField.setBounds(120, 250, 180, 25);
            specField.setVisible(false);
            add(specField);

            JLabel licLbl = new JLabel("License No:");
            licLbl.setBounds(30, 290, 90, 25);
            licLbl.setVisible(false);
            add(licLbl);
            JTextField licField = new JTextField();
            licField.setBounds(120, 290, 180, 25);
            licField.setVisible(false);
            add(licField);

            JButton registerBtn = new JButton("Register");
            registerBtn.setBounds(120, 280, 100, 30);
            add(registerBtn);

            // Dynamic UI: Show/Hide Vet fields based on Role selection
            roleBox.addActionListener(e -> {
                boolean isVet = "Veterinarian".equals(roleBox.getSelectedItem());
                specLbl.setVisible(isVet);
                specField.setVisible(isVet);
                licLbl.setVisible(isVet);
                licField.setVisible(isVet);
                
                // Adjust window size dynamically
                if (isVet) {
                    setSize(350, 430); 
                    registerBtn.setBounds(120, 340, 100, 30); 
                } else {
                    setSize(350, 380); 
                    registerBtn.setBounds(120, 280, 100, 30); 
                }
            });

            // Event Listener to Register User
            registerBtn.addActionListener(e -> {
                String name = nameField.getText();
                String email = emailField.getText();
                String pass = new String(passField.getPassword());
                String city = cityField.getText();
                String selectedRole = (String) roleBox.getSelectedItem();

                try {
                    User newUser;
                    if ("Pet Owner".equals(selectedRole)) {
                        // Member 2: Pet Owner object creation
                        newUser = new PetOwner(0, name, email, pass, city);
                    } else {
                        // Member 1: Veterinarian object creation
                        newUser = new Veterinarian(0, name, email, pass, city, 0, specField.getText(), licField.getText());
                    }

                    // Insert user into database via UserDAO
                    if (userDAO.add(newUser)) {
                        JOptionPane.showMessageDialog(this, "Registration Successful! You can now login.");
                        this.dispose();
                    } else {
                        JOptionPane.showMessageDialog(this, "Registration failed. Email might be in use.");
                    }
                } catch (IllegalArgumentException ex) {
                    // Catch validation exceptions thrown by the User class
                    JOptionPane.showMessageDialog(this, ex.getMessage(), "Validation Error", JOptionPane.ERROR_MESSAGE);
                }
            });
        }
    }

    // =========================================================================
    // MAIN DASHBOARD (Role-based UI routing)
    // =========================================================================
    static class DashboardFrame extends JFrame {
        public DashboardFrame(User user) {
            setTitle("PawPal Dashboard - " + user.getDashboardTitle());
            setSize(750, 600);
            setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            setLocationRelativeTo(null);

            // Member 4: Exit Menu (Replaces Console Option 9)
            JMenuBar menuBar = new JMenuBar();
            JMenu fileMenu = new JMenu("File");
            JMenuItem logoutItem = new JMenuItem("Logout");
            JMenuItem exitItem = new JMenuItem("Exit");
            
            logoutItem.addActionListener(e -> {
                this.dispose();
                new LoginFrame().setVisible(true); 
            });
            
            exitItem.addActionListener(e -> System.exit(0));
            
            fileMenu.add(logoutItem);
            fileMenu.add(exitItem);
            menuBar.add(fileMenu);
            setJMenuBar(menuBar);

            // Tabbed Pane for different system modules
            JTabbedPane tabs = new JTabbedPane();

            // Polymorphism: Render UI components based on the user's role
            if (user.getRole().equals("OWNER")) {
                tabs.add("My Pets", new PetPanel(user));                // Member 2
                tabs.add("Book Appointment", new BookApptPanel(user));  // Member 4
            }
            
            if (!user.getRole().equals("OWNER")) {
                tabs.add("View Veterinarians", new ViewVetsPanel());    // Member 3
            }
            
            tabs.add("Manage Appointments", new ViewApptsPanel(user));  // Member 4

            if (user.getRole().equals("ADMIN")) {
                tabs.add("Manage Vets", new ManageVetsPanel());         // Member 3
                tabs.add("Manage Users", new ManageUsersPanel());       // Member 1
            }

            add(tabs);
        }
    }

