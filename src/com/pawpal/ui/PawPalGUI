            nameLbl.setBounds(20, 20, 80, 25);
            add(nameLbl);
            JTextField nameField = new JTextField();
            nameField.setBounds(100, 20, 150, 25);
            add(nameField);

            JLabel speciesLbl = new JLabel("Species:");
            speciesLbl.setBounds(20, 60, 80, 25);
            add(speciesLbl);
            JTextField speciesField = new JTextField();
            speciesField.setBounds(100, 60, 150, 25);
            add(speciesField);

            JLabel breedLbl = new JLabel("Breed:");
            breedLbl.setBounds(20, 100, 80, 25);
            add(breedLbl);
            JTextField breedField = new JTextField();
            breedField.setBounds(100, 100, 150, 25);
            add(breedField);

            JLabel ageLbl = new JLabel("Age:");
            ageLbl.setBounds(20, 140, 80, 25);
            add(ageLbl);
            JTextField ageField = new JTextField();
            ageField.setBounds(100, 140, 150, 25);
            add(ageField);

            JButton addBtn = new JButton("Register Pet");
            addBtn.setBounds(20, 180, 120, 30);
            add(addBtn);

            JButton viewBtn = new JButton("View My Pets");
            viewBtn.setBounds(150, 180, 120, 30);
            add(viewBtn);

            JTextArea area = new JTextArea();
            area.setEditable(false);
            JScrollPane scroll = new JScrollPane(area);
            scroll.setBounds(20, 230, 680, 250);
            add(scroll);

            // Create Operation: Insert new pet into database
            addBtn.addActionListener(e -> {
                try {
                    String name = nameField.getText();
                    String species = speciesField.getText();
                    String breed = breedField.getText();
                    int age = Integer.parseInt(ageField.getText());

                    Pet p = new Pet(0, user.getUserId(), name, species, breed, age);
                    if (petDAO.add(p)) {
                        JOptionPane.showMessageDialog(this, "Pet Registered!");
                        nameField.setText(""); speciesField.setText("");
                        breedField.setText(""); ageField.setText("");
                    }
                } catch (Exception ex) {
                    JOptionPane.showMessageDialog(this, "Please enter valid data.");
                }
            });

            // Read Operation: Retrieve pets belonging to the logged-in user
            viewBtn.addActionListener(e -> {
                area.setText("--- Your Pets ---\n");
                List<Pet> pets = petDAO.findByOwner(user.getUserId());
                for (Pet p : pets) {
                    area.append("ID: " + p.getPetId() + " | Name: " + p.getPetName() + 
                                " | " + p.getSpecies() + " | Age: " + p.getAge() + "\n");
                }
            });
        }
    }

