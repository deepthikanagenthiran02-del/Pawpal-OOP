    // =========================================================================
    // MEMBER 4: MANAGE APPOINTMENTS (View, Update, Cancel, Delete)
    // =========================================================================
    static class ViewApptsPanel extends JPanel {
        private JTable table;
        private DefaultTableModel model;
        private User currentUser;

        private JTextField newDateField, newTimeField, newReasonField;

        public ViewApptsPanel(User user) {
            this.currentUser = user;
            setLayout(new BorderLayout());

            // JTable setup to display data structurally
            String[] columns = {"ID", "Date", "Time", "Pet Name", "Vet Name", "Status", "Reason"};
            model = new DefaultTableModel(columns, 0);
            table = new JTable(model);
            add(new JScrollPane(table), BorderLayout.CENTER);

            JPanel controlPanel = new JPanel();
            controlPanel.setLayout(new FlowLayout());

            JButton refreshBtn = new JButton("Refresh List");
            controlPanel.add(refreshBtn);

            if (user.getRole().equals("OWNER")) {
                // Owner UI: Can Update Date/Time/Reason or Cancel
                controlPanel.add(new JLabel("New Date:"));
                newDateField = new JTextField(8);
                controlPanel.add(newDateField);

                controlPanel.add(new JLabel("New Time:"));
                newTimeField = new JTextField(5);
                controlPanel.add(newTimeField);

                controlPanel.add(new JLabel("New Reason:"));
                newReasonField = new JTextField(10);
                controlPanel.add(newReasonField);

                JButton updateBtn = new JButton("Update Details");
                controlPanel.add(updateBtn);
                updateBtn.addActionListener(e -> ownerUpdateDetails());

                JButton cancelBtn = new JButton("Cancel Appt");
                controlPanel.add(cancelBtn);
                cancelBtn.addActionListener(e -> updateStatus("CANCELLED"));

            } else if (user.getRole().equals("VET") || user.getRole().equals("ADMIN")) {
                // Vet/Admin UI: Can confirm, complete, cancel, or delete
                JButton confirmBtn = new JButton("Confirm");
                JButton completeBtn = new JButton("Complete");
                JButton cancelStatusBtn = new JButton("Cancel Appt");
                
                controlPanel.add(confirmBtn);
                controlPanel.add(completeBtn);
                controlPanel.add(cancelStatusBtn);

                confirmBtn.addActionListener(e -> updateStatus("CONFIRMED"));
                completeBtn.addActionListener(e -> updateStatus("COMPLETED"));
                cancelStatusBtn.addActionListener(e -> updateStatus("CANCELLED"));

                if (user.getRole().equals("ADMIN")) {
                    JButton deleteBtn = new JButton("Delete Record");
                    controlPanel.add(deleteBtn);
                    deleteBtn.addActionListener(e -> adminDeleteAppt());
                }
            }

            add(controlPanel, BorderLayout.SOUTH);

            refreshBtn.addActionListener(e -> loadData());
            refreshBtn.doClick();
        }

        // Fetch data using AppointmentDAO
        private void loadData() {
            model.setRowCount(0);
            List<Appointment> list = apptDAO.findForUser(currentUser);
            for (Appointment a : list) {
                model.addRow(new Object[]{
                    a.getAppointmentId(), a.getDate(), a.getTime(), 
                    a.getPetName(), a.getVetName(), a.getStatus(), a.getReason()
                });
            }
        }

        // Update Operation: Modify existing appointment details
        private void ownerUpdateDetails() {
            int row = table.getSelectedRow();
            if (row == -1) {
                JOptionPane.showMessageDialog(this, "Please select an appointment first.");
                return;
            }
            try {
                int apptId = (int) model.getValueAt(row, 0);
                LocalDate newDate = LocalDate.parse(newDateField.getText());
                LocalTime newTime = LocalTime.parse(newTimeField.getText());
                String newReason = newReasonField.getText();
                
                if (apptDAO.updateDetails(apptId, newDate, newTime, newReason)) {
                    JOptionPane.showMessageDialog(this, "Appointment Rescheduled Successfully!");
                    loadData();
                } else {
                    JOptionPane.showMessageDialog(this, "Error updating. Check date format.");
                }
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(this, "Invalid input! Use YYYY-MM-DD and HH:MM.");
            }
        }

        // Update Operation: Change appointment status
        private void updateStatus(String newStatus) {
            int row = table.getSelectedRow();
            if (row == -1) {
                JOptionPane.showMessageDialog(this, "Please select an appointment first.");
                return;
            }
            int apptId = (int) model.getValueAt(row, 0);
            if (apptDAO.updateStatus(apptId, newStatus)) {
                JOptionPane.showMessageDialog(this, "Status updated to " + newStatus);
                loadData();
            }
        }

        // Delete Operation: Admin only
        private void adminDeleteAppt() {
            int row = table.getSelectedRow();
            if (row == -1) {
                JOptionPane.showMessageDialog(this, "Please select an appointment first.");
                return;
            }
            int apptId = (int) model.getValueAt(row, 0);
            if (apptDAO.delete(apptId)) {
                JOptionPane.showMessageDialog(this, "Appointment permanently deleted.");
                loadData();
            }
        }
    }

    // =========================================================================
    // MEMBER 3: ADMIN - MANAGE VETS PANEL
    // =========================================================================
    static class ManageVetsPanel extends JPanel {
        public ManageVetsPanel() {
            setLayout(new BorderLayout());
            JTextArea area = new JTextArea();
            area.setEditable(false);
            add(new JScrollPane(area), BorderLayout.CENTER);

            JPanel controls = new JPanel();
            JTextField idField = new JTextField(5);
            JButton deleteBtn = new JButton("Delete Vet by ID");
            JButton refreshBtn = new JButton("Refresh");

            controls.add(new JLabel("Vet ID:"));
            controls.add(idField);
            controls.add(deleteBtn);
            controls.add(refreshBtn);
            add(controls, BorderLayout.SOUTH);

            refreshBtn.addActionListener(e -> {
                area.setText("--- Vets in System ---\n");
                for (Veterinarian v : vetDAO.findAll()) {
                    area.append("ID: " + v.getVetId() + " | " + v.getFullName() + " | " + v.getSpecialization() + "\n");
                }
            });

            // Delete Operation
            deleteBtn.addActionListener(e -> {
                try {
                    int id = Integer.parseInt(idField.getText());
                    if (vetDAO.delete(id)) {
                        JOptionPane.showMessageDialog(this, "Vet deleted successfully.");
                        refreshBtn.doClick();
                    } else {
                        JOptionPane.showMessageDialog(this, "Error: Vet might have appointments.");
                    }
                } catch (Exception ex) { JOptionPane.showMessageDialog(this, "Enter a valid ID."); }
            });
            refreshBtn.doClick();
        }
    }

